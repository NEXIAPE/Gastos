# BETLAB AI - Variables de entorno (copia este archivo a .env)
# Si dejas las claves vacias, el sistema funciona en modo DEMO con datos sinteticos.
# IMPORTANTE: no pongas comentarios en la MISMA linea que un valor.

# --- Claves de API ---
# Clave de api-football.com (fixtures, stats, lesiones y cuotas).
API_FOOTBALL_KEY=
# Host: dejalo asi para el acceso directo (api-sports.io).
API_FOOTBALL_HOST=v3.football.api-sports.io
# Opcional: clave de the-odds-api.com. Si la dejas vacia, las cuotas se toman
# de API-Football (misma clave de arriba).
ODDS_API_KEY=
# Competicion de The Odds API (solo si usas ODDS_API_KEY):
# upcoming | soccer_fifa_world_cup | soccer_epl | soccer_spain_la_liga
ODDS_SPORT=upcoming
ODDS_REGIONS=eu
# Mercados a pedir a The Odds API (endpoint masivo). Solo soporta estos tres:
# h2h (1X2), totals (Over/Under) y spreads (handicap asiatico).
# BTTS y lineas alternativas requieren otro endpoint y NO se piden aqui.
ODDS_MARKETS=h2h,totals,spreads

# --- football-data.org (GRATIS, temporadas actuales + Mundial) ---
# Token gratuito de https://www.football-data.org/client/register
# Si lo configuras, los partidos/resultados salen de aqui (y las cuotas de
# The Odds API). Ideal cuando el plan free de API-Football no cubre la temporada.
FOOTBALLDATA_TOKEN=
# Codigo de competicion: WC (Mundial), PL, PD (La Liga), SA, BL1, FL1, CL...
FD_COMPETITION=WC

# --- Filtro de ingesta (para no agotar la cuota de la API) ---
# Limita la descarga a una competicion/temporada. Mundial 2026 -> 1 / 2026.
# Dejalos vacios para no filtrar (o usa --league/--season en la linea de comandos).
LEAGUE_ID=
SEASON=

# --- Value Bet Engine ---
# EV minimo (5% -> 0.05) para considerar una apuesta de valor.
MIN_EV=0.05
# EV por encima del cual se marca el pick como "poco fiable" (alerta naranja).
EV_WARN=0.30
# Score minimo de confianza (0-100); 80 => Value/Strong/Elite; <80 No Bet.
MIN_CONFIDENCE=80
# Diferencia minima modelo vs mercado (No Bet si es menor).
MIN_PROB_EDGE=0.03
# Rango de cuota elegible (sin restriccion por defecto).
ODD_MIN=1.01
ODD_MAX=1000

# --- No Bet Engine ---
# Bajas importantes que disparan NO BET.
MAX_KEY_INJURIES=3
# Partidos historicos minimos por equipo.
MIN_HISTORY=5

# --- Kelly Criterion ---
# Kelly fraccionado al 25%.
KELLY_FRACTION=0.25
# Bankroll inicial (referencia para sugerir stakes). Podés ponerlo en 0.
BANKROLL=1000
# Símbolo de moneda para mostrar (S/ soles, €, $...).
CURRENCY=S/
# Tope maximo de stake por apuesta (% del bankroll).
MAX_STAKE_PCT=0.10

# --- Bankroll Manager (gestion de riesgo) ---
# Drawdown que reduce stakes al 50%.
DD_REDUCE=0.10
# Drawdown que activa modo conservacion.
DD_CONSERVE=0.20
# Confianza minima en modo conservacion.
CONSERVE_MIN_CONF=90
# Stake maximo (% bankroll) en conservacion.
CONSERVE_MAX_STAKE=0.01

# --- Modelo de Poisson ---
# Ventaja de localia por defecto.
HOME_ADVANTAGE=1.35

# --- Otros ---
DEMO_MODE=false
