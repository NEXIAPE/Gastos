# BETLAB AI - Variables de entorno (copia a .env)
# Si dejas las claves vacías, el sistema funciona en modo DEMO con datos sintéticos.

# --- Claves de API ---
API_FOOTBALL_KEY=                          # fixtures, stats, lesiones y CUOTAS
API_FOOTBALL_HOST=v3.football.api-sports.io
# Opcional: si lo dejas vacío, las cuotas se toman de API-Football (clave de arriba).
# Solo necesario si quieres usar the-odds-api.com como fuente de cuotas.
ODDS_API_KEY=
# Competición de The Odds API (solo si usas ODDS_API_KEY). Ej:
#   upcoming | soccer_fifa_world_cup | soccer_epl | soccer_spain_la_liga
ODDS_SPORT=upcoming
ODDS_REGIONS=eu          # eu, uk, us, au (regiones de casas de apuestas)

# --- Value Bet Engine ---
MIN_EV=0.05            # EV mínimo (5%) para considerar una apuesta de valor
MIN_CONFIDENCE=80      # Score mínimo (80 => Value/Strong/Elite; <80 No Bet)
MIN_PROB_EDGE=0.03     # Diferencia mínima modelo vs mercado (No Bet si menor)
ODD_MIN=1.01           # Cuota mínima elegible (sin restricción por defecto)
ODD_MAX=1000           # Cuota máxima elegible (sube p.ej. ODD_MIN=1.40/ODD_MAX=2.20)

# --- No Bet Engine ---
MAX_KEY_INJURIES=3     # Bajas importantes que disparan NO BET
MIN_HISTORY=5          # Partidos históricos mínimos por equipo

# --- Kelly Criterion ---
KELLY_FRACTION=0.25    # Kelly fraccionado al 25%
BANKROLL=1000          # Bankroll inicial (€)
MAX_STAKE_PCT=0.10     # Tope máximo de stake por apuesta (% bankroll)

# --- Bankroll Manager (gestión de riesgo) ---
DD_REDUCE=0.10         # Drawdown que reduce stakes al 50%
DD_CONSERVE=0.20       # Drawdown que activa modo conservación
CONSERVE_MIN_CONF=90   # Confianza mínima en modo conservación
CONSERVE_MAX_STAKE=0.01 # Stake máximo (% bankroll) en conservación

# --- Modelo de Poisson ---
HOME_ADVANTAGE=1.35    # Ventaja de localía por defecto

# --- Otros ---
DEMO_MODE=false
